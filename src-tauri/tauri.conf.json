{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "editor-minmd",
  "version": "../package.json",
  "identifier": "io.github.tingxi8087.editor-minmd",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1537",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "editor-minmd",
        "width": 1240,
        "height": 820,
        "minWidth": 780,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: http: data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost http://127.0.0.1:1537 ws://127.0.0.1:1537"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "本地 Markdown 所见即所得编辑器",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
